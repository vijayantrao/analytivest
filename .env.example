# Analytivest configuration. Copy to .env (same folder) and edit. No API keys are needed:
# the app uses only free data sources. Never put real secrets in this example file.

# Where your data lives (database and default backup folder). Default: %LOCALAPPDATA%\Analytivest.
# Avoid OneDrive/Dropbox folders: syncing a live database uploads it and can corrupt it.
# STOCKIQ_DATA_DIR=C:\Users\you\AppData\Local\Analytivest

# Extra host names the server answers to (only if you deliberately expose it on your network)
# STOCKIQ_ALLOWED_HOSTS=

# Server bind address. Keep 127.0.0.1 so the app is reachable only from this computer.
STOCKIQ_HOST=127.0.0.1
STOCKIQ_PORT=8000

# Provider order: "yahoo" (Yahoo Finance via yfinance) and/or "sample" (fictional demo data)
STOCKIQ_PROVIDERS=yahoo,sample

# 1 = never call external providers (sample data + whatever is already cached)
STOCKIQ_OFFLINE=0

# Minimum seconds between calls to Yahoo (politeness / rate-limit protection)
STOCKIQ_PROVIDER_MIN_INTERVAL=0.35

# API requests allowed per client per minute
STOCKIQ_RATE_LIMIT_PER_MINUTE=120
